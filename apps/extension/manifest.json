{
  "manifest_version": 3,
  "name": "Marrow",
  "version": "0.2.0",
  "description": "Add the YouTube video, X post or LinkedIn post you are looking at to your Marrow research brain — and keep the server's YouTube session alive with this profile's cookies.",
  "permissions": ["cookies", "storage", "alarms", "tabs", "activeTab", "scripting"],
  "host_permissions": ["https://*.youtube.com/*", "https://*.google.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Marrow" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
