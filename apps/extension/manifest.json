{
  "manifest_version": 3,
  "name": "Marrow",
  "version": "0.4.0",
  "description": "Save the YouTube video, X post or LinkedIn post you're looking at to your Marrow research brain \u2014 from a button right on the page.",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.linkedin.com/*",
    "https://3-7-96-159.sslip.io/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Marrow"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/48.png"
      ],
      "matches": [
        "https://*.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.linkedin.com/*"
      ]
    }
  ]
}
