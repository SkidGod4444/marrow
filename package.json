{
  "name": "marrow",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "test": "turbo run test",
    "test:watch": "vitest",
    "cli": "bun run apps/server/src/cli.ts",
    "server": "bun run apps/server/src/index.ts",
    "db:generate": "bun run --cwd packages/core db:generate",
    "db:migrate": "bun run packages/core/src/db/migrate.ts",
    "server:dev": "bun run --watch apps/server/src/index.ts",
    "web": "bun run --cwd apps/web dev"
  },
  "devDependencies": {
    "@marrow/core": "workspace:*",
    "@types/bun": "^1.4.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.12"
  },
  "type": "module"
}
