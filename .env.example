# ---- Database ----------------------------------------------------------------
# Postgres connection string. Production: Amazon RDS for PostgreSQL (pgvector enabled).
# Local docker-compose: postgres://marrow:marrow@localhost:5432/marrow
# Unset → PGlite (Postgres-in-WASM) at PGLITE_DIR, zero setup — used by the CLI and tests.
DATABASE_URL=
# TLS to Postgres: auto (encrypt for any non-local host; verify with DATABASE_SSL_CA when that file exists — the Docker
# image ships Amazon's RDS bundle at the default path), require, verify-full, or off.
DATABASE_SSL=auto
DATABASE_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem
PGLITE_DIR=.marrow/pglite

# ---- Object storage ----------------------------------------------------------
# "s3" (AWS S3, or MinIO from docker-compose) or "local" (filesystem at LOCAL_STORAGE_DIR).
STORAGE_DRIVER=local
S3_BUCKET=marrow
S3_REGION=ap-south-1
# MinIO only — leave empty for real AWS S3:
S3_ENDPOINT=
# AWS credentials are read by the SDK from the standard variables (or an EC2 instance role in production):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=.marrow/storage
# Scratch space for downloads/frames while a job runs (deleted when the job finishes).
WORK_DIR=.marrow/work

# ---- OpenAI (all hosted ML: STT, VLM, LLM, embeddings) -------------------------
OPENAI_API_KEY=
# whisper-1 is the only OpenAI model that returns word-level timestamps (required by the PRD).
STT_MODEL=whisper-1
# Cheap tier for every pipeline pass; strong tier reserved for interactive chat.
LLM_MODEL_CHEAP=gpt-5.6-luna
LLM_MODEL_CHAT=gpt-5.6-terra
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# ---- Pipeline knobs ----------------------------------------------------------
# Keyframe cap per hour of video (PRD: ~120/hr) and the ffmpeg scene-change threshold (0–1).
FRAMES_PER_HOUR=120
SCENE_THRESHOLD=0.3
FRAME_MIN_GAP_S=2
FRAME_WIDTH=1280
# Highest video resolution to download (720p is plenty for slide OCR).
MAX_VIDEO_HEIGHT=720
VISION_CONCURRENCY=6
# Binaries (override if not on PATH).
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ---- Server ------------------------------------------------------------------
PORT=3001
# Single-owner API key for REST + MCP (PRD §8). Unset = open (local dev only!). Generate: openssl rand -hex 24
# RSS/podcast feeds: new entries ingested per poll (newest first) so a fresh subscription doesn't pull a whole back-catalogue
FEED_MAX_PER_POLL=5

# Capture (PRD §7): server-side fetch of public pages/PDFs
CAPTURE_FETCH_TIMEOUT_MS=15000
CAPTURE_MAX_BYTES=8388608
# Inbound email (docs/CAPTURE.md §3): the provider's webhook posts to /inbound/email/<INBOUND_EMAIL_TOKEN>;
# mails route to the recipient's plus-tag namespace (x+robotics@…) or INBOUND_EMAIL_NAMESPACE
INBOUND_EMAIL_TOKEN=
INBOUND_EMAIL_NAMESPACE=

# Owner login for the web app (Better Auth, runs in this server; docs/DEPLOY.md). MARROW_WEB_URL = the address people
# open the web app at (cookies + CSRF); BETTER_AUTH_SECRET = long random string (openssl rand -hex 32). Sign-up closes after
# the first account. MARROW_AUTH=off removes the login gate — local development only.
MARROW_WEB_URL=http://localhost:3000
BETTER_AUTH_SECRET=
MARROW_AUTH=on

MARROW_API_KEY=

# ---- Production only (docker-compose.prod.yml on the EC2 box) ----------------------
# API subdomain Caddy obtains the HTTPS certificate for (A record → the EC2 Elastic IP), e.g. api.marrow.yourdomain.com.
# The web app runs on Vercel and points MARROW_API_URL at https://<this domain>.
MARROW_API_DOMAIN=
