# Continuous deployment: the box checks origin/main itself every minute (see the timer), no inbound SSH needed.
# Install:  sudo cp docker/marrow-deploy.* /etc/systemd/system/ && sudo systemctl enable --now marrow-deploy.timer
[Unit]
Description=Deploy Marrow server from origin/main if it changed
After=docker.service network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/marrow
ExecStart=/home/ubuntu/marrow/scripts/deploy-ec2.sh
